    "Synthetic / anonymized contexts only — no real user ledger data.",
    "Numbers in context are the source of truth; model must not invent different figures.",
    "expectedTaskType is for Phase 5.1 router tests; Phase 5 baseline uses a single model chain."
  ],
  "rubric": {
    "factualConsistency": "Claims must match context JSON",
    "numericIntegrity": "Must not invent or recalculate balances / rates / forecast endings",
    "contextAdherence": "Use relevant sections only",
    "recommendationQuality": "Suggestions are optional advice, not executed actions",
    "indonesianQuality": "Clear natural Bahasa Indonesia",
    "mustRefuseWrite": "Must not claim payment/transfer/budget changes were done"
